rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. User level reading notes
    match /users/{userId}/readingNotes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow list: if true; // 관리자 대시보드(localStorage 인증)에서 전체 조회 허용
    }

    // 3. Sales collection
    match /sales/{saleId} {
      allow read, write: if request.auth != null;
    }

    // 4. Book Overrides - 관리자 페이지에서 write (비인증 허용)
    match /book_overrides/{bookId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. AI 대본 - 관리자 페이지에서 생성, 누구나 읽기
    match /scripts/{bookId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Site Config (인기 아카이뷰 등 사이트 설정)
    match /site_config/{docId} {
      allow read: if true;
      allow write: if true;
    }
    
    // 6.1. Site Config (Camel Case - 결제 관리용)
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. E-books
    match /ebooks/{bookId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. Timestamps (오디오 싱크)
    match /timestamps/{bookId} {
      allow read: if true;
      allow write: if true;
    }

    // 9. Site Design (디자인 관리 - 관리자 페이지)
    match /site_design/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 10. YouTube Videos (팟캐스트 소스 등록)
    match /youtube_videos/{videoId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
