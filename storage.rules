rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // audio 파일은 관리자 업로드용 (비인증 허용)
    match /audio/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    // 디자인 관리 이미지/영상 업로드 (관리자 전용 경로)
    match /site_design/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    // 도서 표지 업로드
    match /book_covers/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
